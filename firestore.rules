rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Primitives
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'masiboaustin@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStoreOwner(storeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/stores/$(storeId)) &&
        get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------
    // Entity Validators
    // ---------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['owner', 'cashier']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStore(data) {
      return data.keys().hasAll(['ownerId', 'name', 'paybillNumber', 'accountReference', 'location', 'seeded', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'paybillNumber', 'accountReference', 'location', 'seeded', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.paybillNumber is string && data.paybillNumber.size() >= 4 && data.paybillNumber.size() <= 20
        && data.accountReference is string && data.accountReference.size() >= 1 && data.accountReference.size() <= 40
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 120
        && data.seeded is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['ownerId', 'sku', 'name', 'category', 'unit', 'costPrice', 'sellingPrice', 'stockQuantity', 'reorderLevel', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'sku', 'name', 'category', 'unit', 'costPrice', 'sellingPrice', 'stockQuantity', 'reorderLevel', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 32 && data.sku.matches('^[A-Z0-9\\-]+$')
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 140
        && data.category in ['Cement & Masonry', 'Steel & Roofing', 'Plumbing & PVC', 'Paints & Finishes', 'Hand & Power Tools', 'Fasteners & Hardware', 'Electrical & Lighting']
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 30
        && data.costPrice is number && data.costPrice >= 0 && data.costPrice <= 10000000
        && data.sellingPrice is number && data.sellingPrice >= 0 && data.sellingPrice <= 10000000
        && data.stockQuantity is number && data.stockQuantity >= 0 && data.stockQuantity <= 1000000
        && data.reorderLevel is number && data.reorderLevel >= 0 && data.reorderLevel <= 100000
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMpesaAndCreditPayload(data) {
      return (
        (data.paymentMethod == 'cash'
          && data.cashAmount > 0
          && data.mpesaAmount == 0
          && data.creditAmount == 0
          && data.creditBalance == 0
          && data.creditStatus == 'not_applicable'
          && data.mpesaCode == ''
          && data.mpesaStatus == 'not_applicable'
          && (data.cashAmount >= data.totalAmount - 0.02 && data.cashAmount <= data.totalAmount + 0.02))
        ||
        (data.paymentMethod == 'mpesa_paybill'
          && data.cashAmount == 0
          && data.mpesaAmount > 0
          && data.creditAmount == 0
          && data.creditBalance == 0
          && data.creditStatus == 'not_applicable'
          && data.mpesaCode.matches('^[A-Z0-9]{10}$')
          && data.mpesaStatus in ['pending', 'verified', 'flagged']
          && (data.mpesaAmount >= data.totalAmount - 0.02 && data.mpesaAmount <= data.totalAmount + 0.02))
        ||
        (data.paymentMethod == 'split'
          && data.cashAmount > 0
          && data.mpesaAmount > 0
          && data.creditAmount == 0
          && data.creditBalance == 0
          && data.creditStatus == 'not_applicable'
          && data.mpesaCode.matches('^[A-Z0-9]{10}$')
          && data.mpesaStatus in ['pending', 'verified', 'flagged']
          && ((data.cashAmount + data.mpesaAmount) >= (data.totalAmount - 0.02))
          && ((data.cashAmount + data.mpesaAmount) <= (data.totalAmount + 0.02)))
        ||
        (data.paymentMethod == 'credit'
          && data.cashAmount >= 0
          && data.mpesaAmount >= 0
          && data.creditAmount > 0
          && data.creditBalance >= 0
          && data.creditBalance <= data.creditAmount + 0.02
          && data.creditStatus in ['unpaid', 'partial', 'settled']
          && (
            (data.mpesaAmount == 0 && data.mpesaCode == '' && data.mpesaStatus == 'not_applicable') ||
            (data.mpesaAmount > 0 && data.mpesaCode.matches('^[A-Z0-9]{10}$') && data.mpesaStatus in ['pending', 'verified', 'flagged'])
          )
          && ((data.cashAmount + data.mpesaAmount + data.creditBalance) >= (data.totalAmount - 0.02))
          && ((data.cashAmount + data.mpesaAmount + data.creditBalance) <= (data.totalAmount + 0.02)))
      );
    }

    function isValidSale(data) {
      return data.keys().hasAll([
          'ownerId', 'receiptNumber', 'cashierName', 'customerName', 'customerPhone',
          'paymentMethod', 'cashAmount', 'mpesaAmount', 'creditAmount', 'creditBalance', 'creditStatus',
          'mpesaCode', 'mpesaStatus', 'mpesaNote', 'subtotalAmount', 'discountAmount', 'totalAmount',
          'totalCost', 'amountTendered', 'changeDue', 'itemCount', 'itemsSummary', 'status',
          'voidReason', 'saleDateKey', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'receiptNumber', 'cashierName', 'customerName', 'customerPhone',
          'paymentMethod', 'cashAmount', 'mpesaAmount', 'creditAmount', 'creditBalance', 'creditStatus',
          'mpesaCode', 'mpesaStatus', 'mpesaNote', 'subtotalAmount', 'discountAmount', 'totalAmount',
          'totalCost', 'amountTendered', 'changeDue', 'itemCount', 'itemsSummary', 'status',
          'voidReason', 'saleDateKey', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.receiptNumber is string && data.receiptNumber.size() >= 4 && data.receiptNumber.size() <= 32
        && data.cashierName is string && data.cashierName.size() >= 1 && data.cashierName.size() <= 120
        && data.customerName is string && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() <= 30
        && data.paymentMethod in ['cash', 'mpesa_paybill', 'split', 'credit']
        && data.cashAmount is number && data.cashAmount >= 0 && data.cashAmount <= 100000000
        && data.mpesaAmount is number && data.mpesaAmount >= 0 && data.mpesaAmount <= 100000000
        && data.creditAmount is number && data.creditAmount >= 0 && data.creditAmount <= 100000000
        && data.creditBalance is number && data.creditBalance >= 0 && data.creditBalance <= 100000000
        && data.creditStatus in ['not_applicable', 'unpaid', 'partial', 'settled']
        && data.mpesaCode is string && data.mpesaCode.size() <= 10
        && data.mpesaStatus in ['not_applicable', 'pending', 'verified', 'flagged']
        && data.mpesaNote is string && data.mpesaNote.size() <= 240
        && data.subtotalAmount is number && data.subtotalAmount > 0 && data.subtotalAmount <= 100000000
        && data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= data.subtotalAmount
        && data.totalAmount is number && data.totalAmount > 0 && data.totalAmount <= 100000000
        && ((data.subtotalAmount - data.discountAmount) >= (data.totalAmount - 0.02))
        && ((data.subtotalAmount - data.discountAmount) <= (data.totalAmount + 0.02))
        && data.totalCost is number && data.totalCost >= 0 && data.totalCost <= 100000000
        && data.amountTendered is number && data.amountTendered >= 0 && data.amountTendered <= 100000000
        && data.changeDue is number && data.changeDue >= 0 && data.changeDue <= 100000000
        && data.itemCount is number && data.itemCount > 0 && data.itemCount <= 100000
        && data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 400
        && data.status in ['completed', 'voided']
        && data.voidReason is string && data.voidReason.size() <= 240
        && data.saleDateKey is string && data.saleDateKey.size() == 10 && data.saleDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isValidMpesaAndCreditPayload(data);
    }

    function isValidLegacyOrCurrentSaleUpdate(data) {
      return isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.receiptNumber is string && data.receiptNumber.size() >= 4 && data.receiptNumber.size() <= 32
        && data.mpesaStatus in ['not_applicable', 'pending', 'verified', 'flagged']
        && data.mpesaNote is string && data.mpesaNote.size() <= 240
        && data.status in ['completed', 'voided']
        && data.voidReason is string && data.voidReason.size() <= 240
        && data.updatedAt is timestamp
        && (
          !data.keys().hasAny(['creditAmount']) ||
          isValidSale(data)
        );
    }

    function isValidSaleLineItem(data, saleId) {
      return data.keys().hasAll(['ownerId', 'saleId', 'productId', 'sku', 'name', 'unit', 'quantity', 'unitPrice', 'unitCost', 'lineTotal', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'saleId', 'productId', 'sku', 'name', 'unit', 'quantity', 'unitPrice', 'unitCost', 'lineTotal', 'createdAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.saleId)
        && data.saleId == saleId
        && isValidId(data.productId)
        && data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 32
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 140
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 30
        && data.quantity is number && data.quantity > 0 && data.quantity <= 100000
        && data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 10000000
        && data.unitCost is number && data.unitCost >= 0 && data.unitCost <= 10000000
        && data.lineTotal is number && data.lineTotal >= 0 && data.lineTotal <= 100000000
        && data.createdAt is timestamp;
    }

    function isValidStockLog(data) {
      return data.keys().hasAll(['ownerId', 'productId', 'productName', 'sku', 'type', 'quantityDelta', 'previousStock', 'newStock', 'reason', 'actorName', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'productId', 'productName', 'sku', 'type', 'quantityDelta', 'previousStock', 'newStock', 'reason', 'actorName', 'createdAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.productId)
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 140
        && data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 32
        && data.type in ['restock', 'sale', 'void_restore', 'adjustment', 'damage']
        && data.quantityDelta is number && data.quantityDelta >= -100000 && data.quantityDelta <= 100000
        && data.previousStock is number && data.previousStock >= 0 && data.previousStock <= 1000000
        && data.newStock is number && data.newStock >= 0 && data.newStock <= 1000000
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 240
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidDailyReconciliation(data) {
      return data.keys().hasAll(['ownerId', 'dateKey', 'expectedCash', 'countedCash', 'cashVariance', 'expectedMpesa', 'verifiedMpesa', 'pendingMpesaCount', 'totalRevenue', 'notes', 'closedBy', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'dateKey', 'expectedCash', 'countedCash', 'cashVariance', 'expectedMpesa', 'verifiedMpesa', 'pendingMpesaCount', 'totalRevenue', 'notes', 'closedBy', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.expectedCash is number && data.expectedCash >= 0 && data.expectedCash <= 100000000
        && data.countedCash is number && data.countedCash >= 0 && data.countedCash <= 100000000
        && data.cashVariance is number && data.cashVariance >= -100000000 && data.cashVariance <= 100000000
        && data.expectedMpesa is number && data.expectedMpesa >= 0 && data.expectedMpesa <= 100000000
        && data.verifiedMpesa is number && data.verifiedMpesa >= 0 && data.verifiedMpesa <= 100000000
        && data.pendingMpesaCount is number && data.pendingMpesaCount >= 0 && data.pendingMpesaCount <= 100000
        && data.totalRevenue is number && data.totalRevenue >= 0 && data.totalRevenue <= 200000000
        && data.notes is string && data.notes.size() <= 500
        && data.closedBy is string && data.closedBy.size() >= 1 && data.closedBy.size() <= 120
        && data.status in ['open', 'closed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------
    // Collection Rules
    // ---------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin())
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );
      allow delete: if false;
    }

    match /stores/{storeId} {
      allow get: if isSignedIn() && isValidId(storeId) && (storeId == request.auth.uid || (resource != null && existing().ownerId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(storeId)
        && storeId == request.auth.uid
        && isValidStore(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(storeId)
        && isValidStore(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'paybillNumber', 'accountReference', 'location', 'seeded', 'updatedAt']))
        );
      allow delete: if false;

      match /products/{productId} {
        allow get: if isSignedIn() && isValidId(storeId) && isValidId(productId) && (storeId == request.auth.uid || (resource != null && existing().ownerId == request.auth.uid) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isSignedIn()
          && isValidId(storeId)
          && isValidId(productId)
          && isValidProduct(incoming())
          && isStoreOwner(storeId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn()
          && isValidId(storeId)
          && isValidId(productId)
          && isValidProduct(incoming())
          && isStoreOwner(storeId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly(['sku', 'name', 'category', 'unit', 'costPrice', 'sellingPrice', 'reorderLevel', 'isActive', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity', 'updatedAt'])
          );
        allow delete: if isSignedIn() && isValidId(storeId) && isValidId(productId) && (isStoreOwner(storeId) || isAdmin());
      }

      match /sales/{saleId} {
        allow get: if isSignedIn() && isValidId(storeId) && isValidId(saleId) && (storeId == request.auth.uid || (resource != null && existing().ownerId == request.auth.uid) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isSignedIn()
          && isValidId(storeId)
          && isValidId(saleId)
          && isValidSale(incoming())
          && isStoreOwner(storeId)
          && incoming().status == 'completed'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn()
          && isValidId(storeId)
          && isValidId(saleId)
          && isValidLegacyOrCurrentSaleUpdate(incoming())
          && isStoreOwner(storeId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              existing().status != 'voided' && (
                (incoming().diff(existing()).affectedKeys().hasOnly(['mpesaStatus', 'mpesaNote', 'updatedAt'])) ||
                (incoming().status == 'voided' && incoming().voidReason.size() > 0 && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'voidReason', 'updatedAt'])) ||
                (
                  existing().paymentMethod == 'credit'
                  && incoming().creditBalance <= existing().creditBalance
                  && incoming().diff(existing()).affectedKeys().hasOnly([
                    'cashAmount', 'mpesaAmount', 'mpesaCode', 'mpesaStatus', 'mpesaNote',
                    'creditBalance', 'creditStatus', 'updatedAt'
                  ])
                )
              )
            )
          );
        allow delete: if false;

        match /items/{itemId} {
          allow get: if isSignedIn() && isValidId(storeId) && isValidId(saleId) && isValidId(itemId) && (storeId == request.auth.uid || (resource != null && existing().ownerId == request.auth.uid) || isAdmin());
          allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
          allow create: if isSignedIn()
            && isValidId(storeId)
            && isValidId(saleId)
            && isValidId(itemId)
            && isValidSaleLineItem(incoming(), saleId)
            && isStoreOwner(storeId)
            && (
              exists(/databases/$(database)/documents/stores/$(storeId)/sales/$(saleId)) ||
              existsAfter(/databases/$(database)/documents/stores/$(storeId)/sales/$(saleId))
            )
            && incoming().createdAt == request.time;
          allow update, delete: if false;
        }
      }

      match /stockLogs/{logId} {
        allow get: if isSignedIn() && isValidId(storeId) && isValidId(logId) && (storeId == request.auth.uid || (resource != null && existing().ownerId == request.auth.uid) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isSignedIn()
          && isValidId(storeId)
          && isValidId(logId)
          && isValidStockLog(incoming())
          && isStoreOwner(storeId)
          && (
            exists(/databases/$(database)/documents/stores/$(storeId)/products/$(incoming().productId)) ||
            existsAfter(/databases/$(database)/documents/stores/$(storeId)/products/$(incoming().productId))
          )
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }

      match /reconciliations/{recId} {
        allow get: if isSignedIn() && isValidId(storeId) && isValidId(recId) && (storeId == request.auth.uid || (resource != null && existing().ownerId == request.auth.uid) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isSignedIn()
          && isValidId(storeId)
          && isValidId(recId)
          && isValidDailyReconciliation(incoming())
          && isStoreOwner(storeId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn()
          && isValidId(storeId)
          && isValidId(recId)
          && isValidDailyReconciliation(incoming())
          && isStoreOwner(storeId)
          && incoming().ownerId == existing().ownerId
          && incoming().dateKey == existing().dateKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              existing().status != 'closed' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'expectedCash', 'countedCash', 'cashVariance', 'expectedMpesa',
                'verifiedMpesa', 'pendingMpesaCount', 'totalRevenue', 'notes',
                'closedBy', 'status', 'updatedAt'
              ])
            )
          );
        allow delete: if false;
      }
    }
  }
}
