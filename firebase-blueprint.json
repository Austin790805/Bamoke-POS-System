{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated store operator profile stored privately by UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["owner", "cashier"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "Store": {
      "title": "Store",
      "description": "Single-counter hardware store workspace configuration.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "paybillNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "accountReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "seeded": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "paybillNumber", "accountReference", "location", "seeded", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Hardware store inventory item priced in KES.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": ["Cement & Masonry", "Steel & Roofing", "Plumbing & PVC", "Paints & Finishes", "Hand & Power Tools", "Fasteners & Hardware", "Electrical & Lighting"]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "costPrice": {
          "type": "number"
        },
        "sellingPrice": {
          "type": "number"
        },
        "stockQuantity": {
          "type": "number"
        },
        "reorderLevel": {
          "type": "number"
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "sku", "name", "category", "unit", "costPrice", "sellingPrice", "stockQuantity", "reorderLevel", "isActive", "createdAt", "updatedAt"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed or voided counter checkout transaction supporting Cash, M-Pesa Paybill, Split, Credit (Deni), and Discounts.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "receiptNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "cashierName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerName": {
          "type": "string",
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 30
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "mpesa_paybill", "split", "credit"]
        },
        "cashAmount": {
          "type": "number"
        },
        "mpesaAmount": {
          "type": "number"
        },
        "creditAmount": {
          "type": "number"
        },
        "creditBalance": {
          "type": "number"
        },
        "creditStatus": {
          "type": "string",
          "enum": ["not_applicable", "unpaid", "partial", "settled"]
        },
        "mpesaCode": {
          "type": "string",
          "maxLength": 10
        },
        "mpesaStatus": {
          "type": "string",
          "enum": ["not_applicable", "pending", "verified", "flagged"]
        },
        "mpesaNote": {
          "type": "string",
          "maxLength": 240
        },
        "subtotalAmount": {
          "type": "number"
        },
        "discountAmount": {
          "type": "number"
        },
        "totalAmount": {
          "type": "number"
        },
        "totalCost": {
          "type": "number"
        },
        "amountTendered": {
          "type": "number"
        },
        "changeDue": {
          "type": "number"
        },
        "itemCount": {
          "type": "number"
        },
        "itemsSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "status": {
          "type": "string",
          "enum": ["completed", "voided"]
        },
        "voidReason": {
          "type": "string",
          "maxLength": 240
        },
        "saleDateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId", "receiptNumber", "cashierName", "customerName", "customerPhone",
        "paymentMethod", "cashAmount", "mpesaAmount", "creditAmount", "creditBalance", "creditStatus",
        "mpesaCode", "mpesaStatus", "mpesaNote", "subtotalAmount", "discountAmount", "totalAmount",
        "totalCost", "amountTendered", "changeDue", "itemCount", "itemsSummary", "status",
        "voidReason", "saleDateKey", "createdAt", "updatedAt"
      ]
    },
    "SaleLineItem": {
      "title": "SaleLineItem",
      "description": "Individual product line item within a sale (supports fractional units).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "saleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "quantity": {
          "type": "number"
        },
        "unitPrice": {
          "type": "number"
        },
        "unitCost": {
          "type": "number"
        },
        "lineTotal": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "saleId", "productId", "sku", "name", "unit", "quantity", "unitPrice", "unitCost", "lineTotal", "createdAt"]
    },
    "StockLog": {
      "title": "StockLog",
      "description": "Inventory movement and adjustment audit entry.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "sku": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "type": {
          "type": "string",
          "enum": ["restock", "sale", "void_restore", "adjustment", "damage"]
        },
        "quantityDelta": {
          "type": "number"
        },
        "previousStock": {
          "type": "number"
        },
        "newStock": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "productId", "productName", "sku", "type", "quantityDelta", "previousStock", "newStock", "reason", "actorName", "createdAt"]
    },
    "DailyReconciliation": {
      "title": "DailyReconciliation",
      "description": "End-of-day cash drawer count and M-Pesa Paybill shift reconciliation.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "expectedCash": {
          "type": "number"
        },
        "countedCash": {
          "type": "number"
        },
        "cashVariance": {
          "type": "number"
        },
        "expectedMpesa": {
          "type": "number"
        },
        "verifiedMpesa": {
          "type": "number"
        },
        "pendingMpesaCount": {
          "type": "number"
        },
        "totalRevenue": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "closedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["open", "closed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "dateKey", "expectedCash", "countedCash", "cashVariance", "expectedMpesa", "verifiedMpesa", "pendingMpesaCount", "totalRevenue", "notes", "closedBy", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile for authenticated counter staff."
    },
    "/stores/{storeId}": {
      "schema": {
        "$ref": "#/entities/Store"
      },
      "description": "Hardware store configuration owned by storeId == ownerId."
    },
    "/stores/{storeId}/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Hardware store product inventory catalog."
    },
    "/stores/{storeId}/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/Sale"
      },
      "description": "Completed or voided counter sales."
    },
    "/stores/{storeId}/sales/{saleId}/items/{itemId}": {
      "schema": {
        "$ref": "#/entities/SaleLineItem"
      },
      "description": "Normalized line items belonging to a sale."
    },
    "/stores/{storeId}/stockLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/StockLog"
      },
      "description": "Audit trail of stock movements."
    },
    "/stores/{storeId}/reconciliations/{recId}": {
      "schema": {
        "$ref": "#/entities/DailyReconciliation"
      },
      "description": "End-of-day cash & M-Pesa Paybill shift reconciliations."
    }
  }
}
